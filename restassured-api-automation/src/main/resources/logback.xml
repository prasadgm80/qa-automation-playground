<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender. Thread name helps distinguish parallel scenarios. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender keeps a full run log under target/logs. -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/api-automation.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Keep third-party libraries quieter than our own framework logs. -->
    <logger name="org.apache" level="WARN"/>
    <logger name="io.netty" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
